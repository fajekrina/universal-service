    "Input": {
      "description": "type = pilihan, atribut lain menyesuaikan type yang dipilih",
      "variants": {
        "text": {
          "props": {
            "type": "text",
            "name": "fullName",
            "label": "Nama Lengkap",
            "placeholder": "Masukkan nama lengkap",
            "required": true,
            "minLength": 8,
            "maxLength": 50
          }
        },
        "email": {
          "props": {
            "type": "email",
            "name": "email",
            "label": "Email",
            "placeholder": "nama@email.com",
            "required": true,
            "validation": [{ "rule": "email", "message": "Email tidak valid" }]
          }
        },
        "number": {
          "props": {
            "type": "number",
            "name": "age",
            "label": "Umur",
            "placeholder": "17",
            "required": true,
            "min": 17,
            "max": 99
          }
        },
        "tel": {
          "props": {
            "type": "tel",
            "name": "phone",
            "label": "No HP",
            "placeholder": "08xxxxxxxxxx",
            "required": true,
            "minLength": 10
          }
        },
        "password": {
          "props": {
            "type": "password",
            "name": "password",
            "label": "Password",
            "placeholder": "••••••••",
            "required": true,
            "minLength": 8
          }
        },
        "date": {
          "props": {
            "type": "date",
            "name": "birthDate",
            "label": "Tanggal Lahir",
            "required": false,
            "min": "2020-01-01",
            "max": "2030-12-31"
          }
        },
        "checkbox": {
          "props": {
            "type": "checkbox",
            "name": "agree",
            "label": "Setuju syarat",
            "required": true
          }
        }
      },
